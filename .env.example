# Copy this file to .env.local and fill in the values for the dev Supabase project.
# Supabase dashboard: Project Settings, API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, without a trailing slash.
# Local: http://localhost:3000. On Vercel, set it to the live address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# F8: 32 random bytes in base64, for encrypting NID numbers on the server.
# Secret: never commit the value. See docs/SETUP.md section 8.7.
NID_ENCRYPTION_KEY=

# F9: notification emails through the project Gmail (docs/SETUP.md section 8.8).
# Optional on laptops: without them, notifications still show in the app.
# SMTP_PASSWORD and EMAIL_WORKER_SECRET are secrets: never commit the values.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_WORKER_SECRET=
